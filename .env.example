# ─── Azure Speech to Text ───────────────────────────────────────────────────
# Portal Azure → recurso "Speech" → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# ─── Azure AI Language (Text Analytics) ────────────────────────────────────
# Portal Azure → recurso "Language" → Keys and Endpoint
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/

# ─── Modo de operação dos serviços cognitivos ──────────────────────────────
#   auto  → usa Azure quando as credenciais existem; senão usa fallback local
#   azure → exige Azure (falha se não houver credenciais)
#   local → força fallback local (sem chamadas externas)
MODO_SERVICOS=auto

# ─── Canais de alerta (opcionais) ──────────────────────────────────────────
# Webhook (Microsoft Teams, Slack, Discord, etc.) que recebe um JSON por alerta
ALERTA_WEBHOOK_URL=
# E-mail via SMTP
ALERTA_SMTP_HOST=
ALERTA_SMTP_PORT=587
ALERTA_SMTP_USER=
ALERTA_SMTP_PASSWORD=
ALERTA_EMAIL_DESTINO=
